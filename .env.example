# OpenAI key from a dedicated project with a $2 budget (platform.openai.com → Projects)
OPENAI_API_KEY=
# Neon Postgres connection string (Vercel Marketplace → Neon, or neon.tech)
DATABASE_URL=
# Any random string; used to hash IPs for rate limiting
IP_HASH_SALT=
# Set to "false" to switch off live generation (the library keeps working)
GENERATION_ENABLED=true
# Firecrawl key (firecrawl.dev). Optional: without it the agent uses OpenAI web search
FIRECRAWL_API_KEY=
